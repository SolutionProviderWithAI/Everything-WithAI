{
  "openapi": "3.1.0",
  "info": {
    "title": "EverythingWithAI",
    "description": "Portfolio website for Senior .NET Developer specializing in AI & LLM Integration.",
    "version": "1.0.0"
  },
  "paths": {
    "/": {
      "get": {
        "summary": "Home",
        "description": "Renders the full portfolio landing page matching https://ai-solutionworldwithsujit.bolt.host/",
        "operationId": "home__get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/requests": {
      "get": {
        "summary": "View Requests Page",
        "description": "Dashboard to view all project requests submitted by clients.",
        "operationId": "view_requests_page_requests_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/contact": {
      "post": {
        "summary": "Submit Contact",
        "description": "Handles contact form submissions via AJAX with validation and database storage.",
        "operationId": "submit_contact_api_contact_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ContactSubmissionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContactSubmissionResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/advisor": {
      "post": {
        "summary": "Ai Architecture Advisor",
        "description": "Interactive API for clients to get instant AI architecture feasibility & recommendations.",
        "operationId": "ai_architecture_advisor_api_advisor_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AIAdvisorRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AIAdvisorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/health": {
      "get": {
        "summary": "Health Check",
        "description": "Liveness and readiness healthcheck probe for cloud deployment.",
        "operationId": "health_check_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/submissions": {
      "get": {
        "summary": "Get Submissions Json",
        "description": "JSON API endpoint returning recent project requests.",
        "operationId": "get_submissions_json_api_submissions_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/portfolio-data": {
      "get": {
        "summary": "Get Portfolio Data",
        "description": "Raw JSON API providing all portfolio structured data.",
        "operationId": "get_portfolio_data_api_portfolio_data_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/chat/status": {
      "get": {
        "summary": "Chat Engine Status",
        "description": "Checks if local Llama Ollama server is running and returns available models.",
        "operationId": "chat_status_api_chat_status_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "summary": "Chat With Llama Brain",
        "description": "Interactive chat endpoint powered by local Llama brain (my-brain / llama3.2).\nSupports Server-Sent Events (SSE) streaming or standard JSON response.",
        "operationId": "chat_with_llama_api_chat_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AIAdvisorRequest": {
        "properties": {
          "existing_tech": {
            "type": "string",
            "title": "Existing Tech",
            "description": "Client current stack, e.g. .NET Core, ASP.NET, Python"
          },
          "use_case": {
            "type": "string",
            "title": "Use Case",
            "description": "Target AI use-case, e.g. document search, chatbot, automation, voice"
          },
          "database": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Database",
            "description": "Existing database",
            "default": "SQL Server"
          },
          "data_privacy_level": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Data Privacy Level",
            "description": "Privacy constraints",
            "default": "Enterprise / Private"
          }
        },
        "type": "object",
        "required": [
          "existing_tech",
          "use_case"
        ],
        "title": "AIAdvisorRequest"
      },
      "AIAdvisorResponse": {
        "properties": {
          "recommended_architecture": {
            "type": "string",
            "title": "Recommended Architecture",
            "description": "Recommended architecture name"
          },
          "key_components": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Key Components",
            "description": "Key architectural components"
          },
          "implementation_steps": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Implementation Steps",
            "description": "Implementation steps"
          },
          "feasibility_score": {
            "type": "integer",
            "title": "Feasibility Score",
            "description": "Feasibility score out of 100"
          },
          "estimated_timeline": {
            "type": "string",
            "title": "Estimated Timeline",
            "description": "Estimated timeline"
          },
          "pro_tip": {
            "type": "string",
            "title": "Pro Tip",
            "description": "Implementation pro-tip"
          }
        },
        "type": "object",
        "required": [
          "recommended_architecture",
          "key_components",
          "implementation_steps",
          "feasibility_score",
          "estimated_timeline",
          "pro_tip"
        ],
        "title": "AIAdvisorResponse"
      },
      "ChatMessage": {
        "properties": {
          "role": {
            "type": "string",
            "title": "Role",
            "description": "Role: 'user', 'assistant', or 'system'"
          },
          "content": {
            "type": "string",
            "title": "Content",
            "description": "Message text content"
          }
        },
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "title": "ChatMessage"
      },
      "ChatRequest": {
        "properties": {
          "messages": {
            "items": {
              "$ref": "#/components/schemas/ChatMessage"
            },
            "type": "array",
            "title": "Messages",
            "description": "Chat message history"
          },
          "model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model",
            "description": "Ollama model name (my-brain or llama3.2)",
            "default": "my-brain"
          },
          "stream": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Stream",
            "description": "Whether to stream the response via SSE",
            "default": true
          }
        },
        "type": "object",
        "required": [
          "messages"
        ],
        "title": "ChatRequest"
      },
      "ContactSubmissionRequest": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 2,
            "title": "Name",
            "description": "Name of the person reaching out"
          },
          "email": {
            "type": "string",
            "title": "Email",
            "description": "Valid contact email address"
          },
          "company": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100
              },
              {
                "type": "null"
              }
            ],
            "title": "Company",
            "description": "Company name (optional)"
          },
          "project_type": {
            "type": "string",
            "maxLength": 100,
            "minLength": 2,
            "title": "Project Type",
            "description": "Type of project"
          },
          "existing_technology": {
            "type": "string",
            "maxLength": 100,
            "minLength": 2,
            "title": "Existing Technology",
            "description": "Existing software technology"
          },
          "project_description": {
            "type": "string",
            "maxLength": 3000,
            "minLength": 20,
            "title": "Project Description",
            "description": "Detailed project description"
          }
        },
        "type": "object",
        "required": [
          "name",
          "email",
          "project_type",
          "existing_technology",
          "project_description"
        ],
        "title": "ContactSubmissionRequest"
      },
      "ContactSubmissionResponse": {
        "properties": {
          "success": {
            "type": "boolean",
            "title": "Success",
            "description": "Success flag"
          },
          "message": {
            "type": "string",
            "title": "Message",
            "description": "Status message"
          },
          "submission_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Submission Id",
            "description": "Created submission ID"
          }
        },
        "type": "object",
        "required": [
          "success",
          "message"
        ],
        "title": "ContactSubmissionResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}